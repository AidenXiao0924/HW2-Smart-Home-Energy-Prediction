{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "status": {
      "const": "INVALID_INPUT"
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "code",
          "row",
          "field",
          "message"
        ],
        "properties": {
          "code": {
            "enum": [
              "MISSING_COLUMN",
              "INVALID_DATE",
              "NONFINITE_OR_TYPE",
              "TIME_FEATURE_MISMATCH",
              "INVALID_TARGET",
              "FILE_TOO_LARGE",
              "TOO_MANY_ROWS",
              "UNSUPPORTED_URL",
              "CSV_PARSE_ERROR",
              "MODEL_VERSION_MISMATCH",
              "DUPLICATE_HEADER",
              "EMPTY_HEADER",
              "TOO_MANY_COLUMNS",
              "CELL_TOO_LONG",
              "ENCODING_ERROR",
              "EMPTY_CSV",
              "HTTP_ERROR",
              "CORS_OR_NETWORK",
              "REDIRECT_BLOCKED",
              "TIMEOUT",
              "CANCELLED",
              "NUMERIC_OVERFLOW"
            ]
          },
          "row": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "field": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
